  "description": "CLI lintas platform (Windows & macOS) untuk workflow review PR tim LOGis: commit+push, PR via gh, Jira Code Review, notifikasi Teams.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "bin": {
