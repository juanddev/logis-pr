    "commander": "^14.0.3",
    "cross-spawn": "^7.0.6",
    "eslint": "^10.14.0",
    "picocolors": "^1.1.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
